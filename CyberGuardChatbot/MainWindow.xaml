<Window x:Class="CyberGuardChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Chatbot" 
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5E6D3">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ASCII ART HEADER -->
        <Border Grid.Row="0" Background="#8B6914" CornerRadius="10" Margin="5" Padding="15">
            <StackPanel>
                <TextBlock FontFamily="Consolas" FontSize="10" Foreground="#F5E6D3" 
                           TextAlignment="Center" FontWeight="Bold"
                           TextWrapping="Wrap" xml:space="preserve">
                    <![CDATA[
   ___     _              ___                  _    ___ _         _   _         _   
  / __|  _| |__  ___ _ _ / __|_  _ __ _ _ _ __| |  / __| |_  __ _| |_| |__  ___| |_ 
 | (_| || | '_ \/ -_) '_| (_ | || / _` | '_/ _` | | (__| ' \/ _` |  _| '_ \/ _ \  _|
  \___\_, |_.__/\___|_|  \___|\_,_\__,_|_| \__,_|  \___|_||_\__,_|\__|_.__/\___/\__|
      |__/                                                                          
]]>
                </TextBlock>
                <TextBlock Text="🤖 Your Personal Cybersecurity Guardian" 
                           Foreground="#F5E6D3" TextAlignment="Center" 
                           FontSize="14" FontWeight="Bold" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Chat Area -->
        <ListBox x:Name="ChatList" Grid.Row="1" Margin="5" 
                 Background="#F5E6D3" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="{Binding Alignment}" Margin="0,5">
                        <Border CornerRadius="10" Background="{Binding Color}" Padding="10,8" MaxWidth="450">
                            <StackPanel>
                                <TextBlock Text="{Binding Sender}" FontWeight="Bold" Foreground="#8B6914" FontSize="11"/>
                                <TextBlock Text="{Binding Message}" Foreground="White" TextWrapping="Wrap" FontSize="13"/>
                                <TextBlock Text="{Binding Time}" Foreground="#D2B48C" FontSize="9" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Current Topic Display -->
        <Border Grid.Row="2" Background="#D2B48C" CornerRadius="8" Margin="5" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💡 Current Topic: " 
                           Foreground="#5C4033" FontWeight="Bold"/>
                <TextBlock x:Name="TopicText" Grid.Column="1" Foreground="#5C4033"/>
            </Grid>
        </Border>

        <!-- User Input Area -->
        <Border Grid.Row="3" Background="#D2B48C" CornerRadius="10" Margin="5" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputBox" Grid.Column="0" 
                         Background="White" Foreground="#5C4033"
                         FontSize="13" Padding="10" 
                         MinHeight="40" TextWrapping="Wrap"
                         KeyDown="InputBox_KeyDown"
                         BorderBrush="#8B6914" BorderThickness="2"/>

                <Button x:Name="SendBtn" Grid.Column="1" 
                        Content="📤 SEND" Width="80" Height="40"
                        Background="#8B6914" Foreground="#F5E6D3"
                        FontWeight="Bold" Margin="5,0,0,0"
                        Click="SendBtn_Click" Cursor="Hand"/>

                <Button x:Name="ClearBtn" Grid.Column="2" 
                        Content="🗑️ CLEAR" Width="80" Height="40"
                        Background="#5C4033" Foreground="#F5E6D3"
                        FontWeight="Bold" Margin="5,0,0,0"
                        Click="ClearBtn_Click" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="4" Background="#8B6914" Margin="5,0,5,5">
            <StatusBarItem>
                <TextBlock x:Name="StatusBar" Foreground="#F5E6D3" Text="✅ Ready to help you stay safe online!"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>